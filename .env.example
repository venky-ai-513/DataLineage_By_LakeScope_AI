# Keep SQLite for the zero-service fallback, or use the PostgreSQL URL below.
LAKESCOPE_DATABASE_URL=sqlite:///./data/lakescope.db
# LAKESCOPE_DATABASE_URL=postgresql+psycopg://lakescope:replace-with-a-strong-local-password@127.0.0.1:5432/lakescope
LAKESCOPE_POSTGRES_PASSWORD=replace-with-a-strong-local-password
LAKESCOPE_GRAPH_ENABLED=false
LAKESCOPE_NEO4J_URI=bolt://127.0.0.1:7687
LAKESCOPE_NEO4J_USER=neo4j
LAKESCOPE_NEO4J_PASSWORD=replace-with-a-strong-local-graph-password
LAKESCOPE_NEO4J_DATABASE=neo4j
LAKESCOPE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LAKESCOPE_TRUSTED_HOSTS=127.0.0.1,localhost
LAKESCOPE_AWS_PROFILE=
LAKESCOPE_AWS_REGION=ap-southeast-2
LAKESCOPE_ATHENA_WORKGROUP=primary
LAKESCOPE_GLUE_CATALOG=AwsDataCatalog
LAKESCOPE_QUERY_HISTORY_LIMIT=1000
LAKESCOPE_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
LAKESCOPE_ADMIN_SESSION_HOURS=8
LAKESCOPE_ADMIN_COOKIE_SECURE=false
LAKESCOPE_ADMIN_MAX_LOGIN_ATTEMPTS=5
LAKESCOPE_ADMIN_LOGIN_WINDOW_SECONDS=300
LAKESCOPE_API_DOCS_ENABLED=false

# Sites allowed to embed LakeScope in an iframe, comma-separated (empty = framing blocked).
# LAKESCOPE_FRAME_ANCESTORS=https://crgiwtool02:2026
# strict (default) | lax | none. "none" needs LAKESCOPE_ADMIN_COOKIE_SECURE=true; use it only
# when a site on another domain embeds LakeScope and admins sign in inside the frame.
# LAKESCOPE_ADMIN_COOKIE_SAMESITE=strict

# --- Local AI layer: LakeScope's own Ollama instance ---
# scripts\start-ai.cmd starts it on LAKESCOPE_OLLAMA_PORT (127.0.0.1 only); scripts\stop-ai.cmd stops it.
# It is separate from any other Ollama on this machine (e.g. port 11434) and shares the model folder.
# LAKESCOPE_AI_NUM_THREAD caps CPU threads per request so other apps keep some CPU.
LAKESCOPE_AI_ENABLED=false
LAKESCOPE_AI_BASE_URL=http://127.0.0.1:11435
LAKESCOPE_AI_CHAT_MODEL=qwen3.5:9b
LAKESCOPE_AI_EMBED_MODEL=nomic-embed-text
LAKESCOPE_AI_TIMEOUT_SECONDS=300
LAKESCOPE_AI_MAX_TOOL_STEPS=5
LAKESCOPE_AI_NUM_THREAD=3
LAKESCOPE_OLLAMA_EXE=D:\Ollama\ollama.exe
LAKESCOPE_OLLAMA_PORT=11435
LAKESCOPE_OLLAMA_MODELS=D:\Ollama\models

# Bitbucket view repositories (configured in Admin -> Bitbucket; the token is stored encrypted, never here).
# Leave empty to find git.exe on PATH or in C:\Program Files\Git.
LAKESCOPE_GIT_EXECUTABLE=

# LakeScope's own Neo4j (scripts/start-neo4j.cmd). Defaults shown; only needed if installed elsewhere.
# LAKESCOPE_NEO4J_HOME=C:\LakeScope\neo4j\neo4j-community-5.26.19
# LAKESCOPE_NEO4J_JAVA_HOME=C:\LakeScope\neo4j\jdk-21.0.13.1+2
